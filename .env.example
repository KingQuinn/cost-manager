ENVIRONMENT=development

GEMINI_API_KEY=your_gemini_api_key_here

WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_VERIFY_TOKEN=pick_a_random_string_for_meta_webhook_handshake
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_RECIPIENT_TEST_NUMBER=optional_test_recipient_e164
WHATSAPP_APP_SECRET=your_meta_app_secret_here

SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
USE_SUPABASE=false

CRON_SHARED_SECRET=pick_a_random_string_if_using_external_cron

# Conversation agent (optional overrides — defaults shown)
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
INTENT_MIN_CONFIDENCE=0.7
MEMORY_RECENT_TURNS=12
MEMORY_COMPACT_AFTER=40
MEMORY_STATE_TTL_MINUTES=30

# Langfuse tracing — leave as-is to keep tracing off
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
