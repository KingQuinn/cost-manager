   "tags": [
    "everyday"
   ],
   "household": "confirmed",
   "message": "what can you do?",
   "expect": {
    "intent": "help"
   }
  },
  {
   "id": "thanks",
   "tags": [
    "everyday"
   ],
   "household": "confirmed",
   "message": "thank you!",
   "expect": {
    "intent": "smalltalk"
   }
  },
  {
